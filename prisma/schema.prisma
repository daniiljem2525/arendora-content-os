// PostgreSQL variant of the schema. Applied by `npm run db:postgres`
// (requires DATABASE_URL pointing at PostgreSQL, e.g. via docker-compose).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin") // admin | editor | viewer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Platform {
  id      String  @id @default(cuid())
  key     String  @unique // tiktok | instagram | x | threads | seo
  name    String
  enabled Boolean @default(true)
}

model Campaign {
  id        String        @id @default(cuid())
  name      String
  goal      String        @default("traffic")
  status    String        @default("active")
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  ideas     Idea[]
  content   ContentItem[]
}

model ResearchItem {
  id        String   @id @default(cuid())
  source    String
  type      String
  title     String
  summary   String
  evidence  String?  @default("{}")
  sourceUrl String?
  score     Float    @default(0)
  status    String   @default("new")
  createdAt DateTime @default(now())
  ideas     Idea[]
}

model Idea {
  id             String        @id @default(cuid())
  title          String
  angle          String
  researchItemId String?
  researchItem   ResearchItem? @relation(fields: [researchItemId], references: [id])
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id])
  virality       Float         @default(0)
  relevance      Float         @default(0)
  differentiation Float        @default(0)
  conversion     Float         @default(0)
  totalScore     Float         @default(0)
  status         String        @default("new")
  rationale      String?
  createdAt      DateTime      @default(now())
  contentItems   ContentItem[]
}

model ContentItem {
  id              String          @id @default(cuid())
  ideaId          String
  idea            Idea            @relation(fields: [ideaId], references: [id])
  campaignId      String?
  campaign        Campaign?       @relation(fields: [campaignId], references: [id])
  title           String
  primaryPlatform String          @default("tiktok")
  status          String          @default("draft")
  scheduledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  variants        ContentVariant[]
}

model ContentVariant {
  id            String        @id @default(cuid())
  contentItemId String
  contentItem   ContentItem   @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  platform      String
  kind          String
  payload       String
  status        String        @default("draft")
  qaScore       Float?
  qaReport      String?
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  publications  Publication[]
}

model Publication {
  id          String            @id @default(cuid())
  variantId   String
  variant     ContentVariant    @relation(fields: [variantId], references: [id])
  platform    String
  mode        String            @default("mock")
  status      String            @default("pending")
  externalId  String?
  externalUrl String?
  error       String?
  attempts    Int               @default(0)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  analytics   AnalyticsRecord[]
}

model AnalyticsRecord {
  id             String       @id @default(cuid())
  publicationId  String?
  publication    Publication? @relation(fields: [publicationId], references: [id])
  platform       String
  date           DateTime
  impressions    Int          @default(0)
  views          Int          @default(0)
  likes          Int          @default(0)
  comments       Int          @default(0)
  shares         Int          @default(0)
  saves          Int          @default(0)
  clicks         Int          @default(0)
  ctr            Float        @default(0)
  profileVisits  Int          @default(0)
  websiteVisits  Int          @default(0)
  registrations  Int          @default(0)
  activatedUsers Int          @default(0)
  conversions    Int          @default(0)
  isMock         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([platform, date])
}

model Experiment {
  id        String    @id @default(cuid())
  name      String
  hypothesis String
  kind      String    @default("hook")
  variants  String    @default("[]")
  status    String    @default("running")
  startDate DateTime  @default(now())
  endDate   DateTime?
  result    String?
  createdAt DateTime  @default(now())
}

model BrandRule {
  id        String   @id @default(cuid())
  key       String   @unique
  category  String
  value     String
  updatedAt DateTime @updatedAt
}

model ProductKnowledge {
  id        String   @id @default(cuid())
  title     String
  category  String
  body      String
  source    String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Keyword {
  id         String       @id @default(cuid())
  phrase     String
  intent     String       @default("informational")
  cluster    String?
  volume     Int?
  difficulty Int?
  source     String       @default("manual")
  status     String       @default("new")
  createdAt  DateTime     @default(now())
  articles   SeoArticle[]
}

model SeoArticle {
  id              String    @id @default(cuid())
  keywordId       String?
  keyword         Keyword?  @relation(fields: [keywordId], references: [id])
  contentItemId   String?
  title           String
  metaDescription String
  h1              String
  outline         String    @default("[]")
  body            String?
  internalLinks   String    @default("[]")
  faqSchema       String    @default("[]")
  cta             String?
  status          String    @default("draft")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model LearningInsight {
  id         String   @id @default(cuid())
  kind       String
  finding    String
  evidence   String   @default("{}")
  confidence Float    @default(0)
  createdAt  DateTime @default(now())
}

model IntegrationCredential {
  id        String   @id @default(cuid())
  key       String   @unique
  data      String
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model StrategyPlan {
  id        String   @id @default(cuid())
  weekStart String
  notes     String   @default("")
  ideaIds   String   @default("[]")
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model JobDefinition {
  id       String  @id @default(cuid())
  key      String  @unique
  name     String
  cron     String
  workflow String
  enabled  Boolean @default(true)
}

model JobRun {
  id         String    @id @default(cuid())
  workflow   String
  trigger    String    @default("manual")
  status     String    @default("running")
  logs       String    @default("")
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}
