# ============================================================
# Arendora Content OS - environment configuration
# Copy to .env and fill in what you have. Every integration works
# without credentials via clearly-marked mock adapters.
# ============================================================

# --- Database (required) ---
# SQLite (local development default):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production; see docker-compose.yml):
# DATABASE_URL="postgresql://arendora:arendora_dev_password@localhost:5432/arendora_content_os"

# --- Auth (required) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="admin@arendora.ru"
ADMIN_PASSWORD="ChangeMeNow2026"

# --- LLM (optional) ---
# Any OpenAI-compatible API. If unset, the platform runs on a clearly
# labeled deterministic mock LLM (MOCK mode in the dashboard).
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# --- Web/search providers (optional; Research Agent) ---
TAVILY_API_KEY=""
BRAVE_API_KEY=""
SERPER_API_KEY=""

# --- Social publishing APIs (optional) ---
# NOTE: with no credentials, publishing stays in MOCK mode and is
# never reported as a successful live publication.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
META_GRAPH_VERSION="v21.0"
THREADS_ACCESS_TOKEN=""
THREADS_USER_ID=""
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""
TIKTOK_ACCESS_TOKEN=""

# --- Analytics integrations (optional) ---
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=""
GSC_PROPERTY_URL="sc-domain:arendora.ru"
GOOGLE_ANALYTICS_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Feature flags ---
# Allow the Analytics Agent to seed clearly-labeled mock metrics for local
# development so the dashboard has data. Never enable in production.
ANALYTICS_MOCK_DATA="true"
# Force mock LLM even if OPENAI_API_KEY is set (useful for tests/demos).
MOCK_LLM="false"

# --- External cron (for serverless hosting: Vercel, Railway, etc.) ---
# Secret for GET/POST /api/v1/cron/publish - call it every minute from an
# external scheduler when the app cannot run its own in-process loop.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""
