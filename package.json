{
  "name": "arendora-content-os",
  "version": "1.0.0",
  "private": true,
  "description": "AI marketing automation platform for Arendora - research, strategy, content, SEO, QA, analytics and publishing.",
  "scripts": {
    "dev": "cross-env NODE_USE_ENV_PROXY=1 next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_USE_ENV_PROXY=1 next start -p 3000",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:postgres": "node scripts/switch-postgres.mjs apply",
    "db:postgres:revert": "node scripts/switch-postgres.mjs revert",
    "scheduler": "tsx src/scheduler/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx tests/e2e/workflow.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "jose": "^5.9.6",
    "next": "^15.1.6",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
